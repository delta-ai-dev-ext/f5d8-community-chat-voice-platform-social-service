# Local development only. Never commit a real .env file.
DATABASE_URL=postgres://social:social@localhost:5432/social?sslmode=disable
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=social_service
# KAFKA_SASL_MECHANISM=plain
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_TLS_ENABLED=false
# Directory holding current.pem / next.pem, a JSON keys file, or a single PEM file.
TOKEN_VERIFICATION_KEYS_PATH=./secrets/jwt-keys
TOKEN_ISSUER=identity_service
TOKEN_AUDIENCE=social_service
HTTP_PORT=8080
SHUTDOWN_TIMEOUT_SECONDS=30
LOG_LEVEL=info
